<!-- DASHBOARD PAGE -->
    <div class="page active" id="page-dashboard">
      <div class="page-header"><div class="page-header-left"><h1>Hola 👋</h1><p>Resumen de tu tienda.</p></div></div>
      <div class="kpi-grid" id="kpi-grid"></div>
      <div class="card" style="margin-bottom:24px">
        <div class="card-header">
          <div class="card-header-left"><h3>Visitas a la tienda</h3><p>Personas que entraron a cualquier página: inicio, categorías o productos</p></div>
          <select class="filter-select" id="dash-days" onchange="renderDashChart(true)">
            <option value="7">Últimos 7 días</option>
            <option value="30">Últimos 30 días</option>
          </select>
        </div>
        <div class="card-body">
          <div id="dash-status" style="font-size:13px;color:var(--text-3);margin-bottom:8px"></div>
          <div style="position:relative;height:340px"><canvas id="dash-traffic"></canvas></div>
        </div>
      </div>
    </div>