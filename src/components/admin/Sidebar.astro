<!-- ===== SIDEBAR ===== -->
<aside id="sidebar" aria-label="Navegación principal">
  <div class="sidebar-logo">
    <div class="logo-mark">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
    </div>
    <div class="logo-text">
      <div class="logo-name">Autoboutique Olga</div>
      <div class="logo-sub">Panel de administración</div>
    </div>
  </div>

  <nav>
    <div class="nav-section"><div class="nav-section-label">Principal</div>
      <button class="nav-item active" data-page="dashboard" onclick="navigate('dashboard', this)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        Dashboard
      </button>
      <button class="nav-item" data-page="products" onclick="navigate('products', this)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg>
        Productos
      </button>
    </div>
    <div class="nav-section"><div class="nav-section-label">Catálogo</div>
      <button class="nav-item" data-page="categories" onclick="navigate('categories', this)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 17h7M17 14v7"/></svg>
        Categorías
      </button>
    </div>
    <div class="nav-section"><div class="nav-section-label">Crecimiento</div>
      <button class="nav-item" data-page="analytics" onclick="navigate('analytics', this)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        Analítica
      </button>
    </div>
    
  </nav>

  <div class="sidebar-bottom">
    <button class="nav-item" id="dark-toggle" onclick="toggleDark()">
      <svg id="dark-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
      <span id="dark-label">Modo oscuro</span>
    </button>
  </div>
</aside>

<!-- Overlay -->
<div id="sidebar-overlay" onclick="closeSidebar()"></div>
