<div id="login" class="login-wrap">
<form class="login-card" onsubmit="event.preventDefault();doLogin()">
<h1>Autoboutique Olga</h1>
<p>Panel de administración</p>
<label class="form-label">Correo</label>
<input id="login-email" class="form-control" type="email" autocomplete="username" required>
<label class="form-label" style="margin-top:12px">Contraseña</label>
<input id="login-pass" class="form-control" type="password" 
autocomplete="current-password" required>
<div id="login-error" class="login-error"></div>
<button class="btn btn-primary" style="width:100%;justify-content:center;margin-top:16px" type="submit">Entrar</button></form></div>
