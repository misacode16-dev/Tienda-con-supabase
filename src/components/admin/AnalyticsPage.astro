<!-- ANALYTICS PAGE (Cloudflare Web Analytics) -->
    <div class="page" id="page-analytics">
      <div class="page-header">
        <div class="page-header-left"><h1>Analítica</h1><p>Visitas, productos más vistos y canales de origen</p></div>
        <select class="filter-select" id="an-days" onchange="loadAnalytics(true)">
          <option value="7">Últimos 7 días</option>
          <option value="30">Últimos 30 días</option>
        </select>
      </div>
      <div id="an-status" style="color:var(--text-3);font-size:13px;margin-bottom:12px"></div>
      <div class="stats-grid" style="margin-bottom:20px">
        <div class="stat-card"><div class="value" id="an-visits">—</div><div class="label">Visitas a la tienda</div></div>
        <div class="stat-card"><div class="value" id="an-views">—</div><div class="label">Páginas vistas</div></div>
      </div>
      <div class="dash-grid">
        <div class="card"><div class="card-header"><div class="card-header-left"><h3>Productos más vistos</h3><p>Los que generan más interés</p></div></div><div class="card-body" id="an-products"></div></div>
        <div class="card"><div class="card-header"><div class="card-header-left"><h3>Canales de origen</h3><p>De dónde llegan tus visitas</p></div></div><div class="card-body" id="an-channels"></div></div>
      </div>
    </div>