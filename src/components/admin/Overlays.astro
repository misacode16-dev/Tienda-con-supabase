<!-- Confirm Dialog -->
<div id="confirm-dialog">
  <div class="confirm-box">
    <div class="confirm-icon">🗑️</div>
    <h3 id="confirm-title">¿Eliminar elemento?</h3>
    <p id="confirm-msg">Esta acción no se puede deshacer.</p>
    <div class="confirm-btns">
      <button class="btn btn-secondary" onclick="closeConfirm()">Cancelar</button>
      <button class="btn btn-danger" onclick="doDelete()">Eliminar</button>
    </div>
  </div>
</div>

<!-- Global Search -->
<div id="global-search" onclick="closeGlobalSearch(event)">
  <div class="gs-panel" onclick="event.stopPropagation()">
    <div class="gs-input-wrap">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input id="gs-input" type="text" placeholder="Buscar en el panel..." oninput="gsSearch(this.value)" autocomplete="off">
    </div>
    <div class="gs-results" id="gs-results"></div>
  </div>
</div>

<!-- Toast Container -->
<div id="toast-container"></div>
