<!-- Category Modal -->
<div class="modal-overlay" id="category-modal"><div class="modal">
  <div class="modal-header"><h2>Nueva categoría</h2><button class="modal-close icon-btn" onclick="closeModal('category-modal')" aria-label="Cerrar">✕</button></div>
  <div class="modal-body">
    <div class="form-row form-row-2">
      <div class="form-group"><label class="form-label">Nombre</label><input class="form-control" id="cat-name" placeholder="Ej: Alarmas Genius"></div>
      <div class="form-group"><label class="form-label">Slug (URL)</label><input class="form-control" id="cat-slug" placeholder="alarma-genius"></div>
    </div>
    <div class="form-row"><div class="form-group"><label class="form-label">Descripción (SEO)</label><textarea class="form-control" id="cat-desc" placeholder="Texto de la página de la categoría..."></textarea></div></div>
  </div>
  <div class="modal-footer"><button class="btn btn-secondary" onclick="closeModal('category-modal')">Cancelar</button><button class="btn btn-primary" onclick="saveCategory()">Crear categoría</button></div>
</div></div>
