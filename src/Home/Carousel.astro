<section class="mt-[72px] w-full">
  <div class="mx-auto overflow-hidden shadow-[0_10px_20px_rgba(0,0,0,0.15)]">
    <div class="carousel-track flex transition-transform [800ms] ease-in-out" id="track">
      <img class="w-full flex-shrink-0 object-cover h-[250px] md:h-[550px]" src="/home/alarma slider 1.webp" alt="slider-alarmas" />
      <img class="w-full flex-shrink-0 object-cover h-[250px] md:h-[550px]" src="/home/audio slider 2.webp" alt="slider-audio" />
      <img class="w-full flex-shrink-0 object-cover h-[250px] md:h-[550px]" src="/home/luces slider 3.webp" alt="slider-luces" />
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('track');
    if (!track) return;
    let current = 0;
    const slides = track.children.length;
    setInterval(() => {
      current = (current + 1) % slides;
      track.style.transform = `translateX(-${current * 100}%)`;
    }, 4000);
  });
</script>