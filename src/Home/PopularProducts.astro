---
// components/PopularProducts.astro
import products from '../data/products.json';
import categories from '../data/categories.json';
import { getCoverImage } from '../utils/product-images.js';

const LIMIT = 5;

function categoryName(slug) {
  return categories.find((c) => c.slug === slug)?.name ?? '';
}

// No hace falta marcar productos a mano: se baraja TODO el catálogo al
// momento del build (Fisher-Yates) y se toman los primeros LIMIT. El orden
// final que ve cada visitante se vuelve a barajar en el navegador al cargar
// la página (ver el <script> más abajo), así nunca se ve siempre igual.
function shuffle(array) {
  const copy = [...array];
  for (let i = copy.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [copy[i], copy[j]] = [copy[j], copy[i]];
  }
  return copy;
}

const displayProducts = shuffle(products).slice(0, LIMIT);
---

<section class="max-w-[1200px] mx-auto px-[15px] py-[30px] pb-[50px]">
  <div class="flex justify-between items-center mb-[30px]">
    <h2 class="text-[22px] font-extrabold text-brand-dark">Productos populares</h2>
  </div>
  <div id="popular-products-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-2.5">
    {displayProducts.map((p) => (
      <a
        href={`/tienda/${p.slug}`}
        class="p-5 border border-brand-light rounded-2xl flex flex-col relative bg-brand-white shadow-[0_4px_12px_rgba(0,0,0,0.06)] transition-all duration-350 hover:shadow-[0_12px_32px_rgba(0,0,0,0.14)] hover:-translate-y-1.5 overflow-hidden group"
      >
        <div class="h-[130px] flex items-center justify-center my-2.5 mb-4">
          <img src={getCoverImage(p)} alt={p.name} class="max-h-full max-w-full object-contain transition-transform duration-350 group-hover:scale-105" />
        </div>
        <span class="text-[11px] text-[#535353] uppercase tracking-[0.04em] mb-1.5">{categoryName(p.category)}</span>
        <h4 class="text-[13px] font-bold text-brand-dark leading-[1.35] mb-2.5 h-9 overflow-hidden line-clamp-2">{p.name}</h4>
        <div class="flex items-center gap-1.5">
          <span class="text-[14px] font-extrabold text-[#ff5b00]">S/ {p.price.toFixed(2)}</span>
        </div>
      </a>
    ))}
  </div>
</section>

<script>
  // Vuelve a barajar el orden de estas tarjetas en cada visita/recarga
  // (Fisher-Yates), aunque el conjunto de productos ya viene fijado desde
  // el build.
  const grid = document.getElementById('popular-products-grid');
  if (grid) {
    const cards = Array.from(grid.children);
    for (let i = cards.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [cards[i], cards[j]] = [cards[j], cards[i]];
    }
    cards.forEach((card) => grid.appendChild(card));
  }
</script>