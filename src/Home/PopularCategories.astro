---
// components/CategoryGrid.astro
const categories = [
  {
    label: 'Parlantes',
    href: '/categoria/parlantes',
    class: 'col-span-1 sm:col-span-3 sm:row-span-2',
    image: '/home/categoria-parlantes.webp'
  },
  {
    label: 'Alarmas',
    href: '/categoria/alarma-autorus',
    class: 'col-span-1 sm:col-span-2 sm:row-span-3 sm:col-start-1 sm:row-start-3',
    image: '/home/categoria-alarmas.webp'
  },
  {
    label: 'Radios',
    href: '/categoria/autoradios',
    class: 'col-span-1 sm:row-span-3 sm:col-start-3 sm:row-start-3',
    image: '/home/categoria-radios.webp'
  },
  {
    label: 'Focos led H4',
    href: '/categoria/focos-led-h4-para-auto',
    class: 'col-span-1 sm:row-span-5 sm:col-start-4 sm:row-start-1',
    image: '/home/categorias-luces.webp'
  },
];
---

<section id="categorias" class="max-w-[1200px] mx-auto px-4 sm:px-[15px] py-8 sm:py-[50px] pb-6 sm:pb-[30px]">
  <div class="flex justify-between items-center mb-5 sm:mb-[30px]">
    <h2 class="text-[20px] sm:text-[22px] font-extrabold text-brand-dark">
      Categorías populares
    </h2>
  </div>

  <div class="grid grid-cols-2 grid-rows-2 sm:grid-cols-4 sm:grid-rows-5 gap-2 sm:gap-2 h-auto sm:h-[500px]">
    {categories.map((cat) => (
      <a
        href={cat.href}
        class={`relative min-h-[160px] sm:min-h-0 bg-cover bg-center rounded-xl overflow-hidden cursor-pointer transition-all duration-400 hover:scale-[1.02] hover:shadow-[0_20px_40px_rgba(0,0,0,0.25)] group block ${cat.class}`}
        style={`background-image: url('${cat.image}')`}
      >
        <div class="absolute inset-0 bg-gradient-to-b from-[rgba(0,0,0,0.15)] to-[rgba(0,0,0,0.65)] group-hover:from-[rgba(0,0,0,0.35)] group-hover:to-[rgba(0,0,0,0.75)] transition-all duration-400"></div>

        <span class="absolute bottom-4 left-4 sm:bottom-6 sm:left-7 z-10 text-white text-[1rem] sm:text-[1.6rem] font-extrabold uppercase tracking-[0.05em] drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)] group-hover:-translate-y-1 transition-transform duration-400">
          {cat.label}
        </span>
      </a>
    ))}
  </div>
</section>

