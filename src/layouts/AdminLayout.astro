---
// Layout del panel de administración (separado del Layout de la tienda:
// sin Navbar, Footer ni datos estructurados, y con noindex).
import '../styles/admin.css';
const { title = 'Panel — Autoboutique Olga' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
