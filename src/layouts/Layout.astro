---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Head from "./Head.astro";
import { getLocalBusinessSchema, getWebSiteSchema} from '../utils/schemas.js';

const {
  title, description, ogType, image, url,
  ogTitle, ogDescription, ogImage,
  twitterTitle, twitterDescription, twitterImage,
  alt, noindex, structuredData, preloadImage,
  price, priceCurrency, availability
} = Astro.props;

// Schemas globales del negocio: van en TODAS las páginas, sin que cada
// página tenga que importarlos o repetirlos.
const globalSchemas = [
  getLocalBusinessSchema(),
  getWebSiteSchema(),
];

// Cada página puede mandar sus propios schemas (Product, CollectionPage, etc.)
// vía el prop structuredData. Aquí se combinan con los globales.
const pageSchemas = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];

const allSchemas = [...globalSchemas, ...pageSchemas];
---
<!doctype html>
<html lang="es-PE" prefix="og: https://ogp.me/ns# product: https://ogp.me/ns/product#">
  <head>
    <Head
      title={title}
      description={description}
      ogType={ogType}
      image={image}
      url={url}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
      ogImage={ogImage}
      twitterTitle={twitterTitle}
      twitterDescription={twitterDescription}
      twitterImage={twitterImage}
      alt={alt}
      noindex={noindex}
      structuredData={allSchemas}
      preloadImage={preloadImage}
      price={price}
      priceCurrency={priceCurrency}
      availability={availability}
    />
  </head>
  <body>
    <Navbar />
    <slot />
    <Footer />
  </body>
</html>