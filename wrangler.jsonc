{
  "$schema": "./node_modules/wrangler/config-schema.json",
    // Debe llamarse igual que tu Worker (tienda-con-supabase.<tu-cuenta>.workers.dev)
  "name": "tienda-con-supabase",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Solo /api/* pasa por el Worker; lo demás se sirve directo desde la tienda
    "run_worker_first": ["/api/*"]
  }
}